# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/wantace_estimator
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wantace_estimator
MONGO_URI=mongodb://127.0.0.1:27017/wantace_estimator

# Port the API listens on
PORT=5000

# Secret used to sign owner-panel JWTs. Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_string

# Owner panel login credentials (seeded into the DB the first time you run `npm run seed`)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=northline2026

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173
